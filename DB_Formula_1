-- Queries
select nomeP as 'Paises'
from tb_paises
where nomeP like "b%l";
SELECT tb_pilotos.nomePI as 'Pilotos', tb_paises.nomeP as 'Paises'
FROM tb_pilotos, tb_paises
WHERE tb_pilotos.cod_pais = tb_paises.codigoP
AND tb_paises.nomeP IN ('Brasil', 'Italia', 'Franca');
select nomePI as 'Piloto'
from tb_pilotos;
-- Gp
SELECT nome_gp AS Grande_Premio, qtd_voltas AS Voltas
FROM tb_corridas;
SELECT nomePI as 'Piloto', salario
FROM tb_pilotos
WHERE salario >= 70000 and salario <= 100000;
-- media salarial
SELECT cod_pais as 'Pais', round(AVG(salario),2) AS "Media Salarial"
FROM tb_pilotos
GROUP BY cod_pais;
-- Valor salarial
SELECT DISTINCT tb_pilotos.salario AS "Salarios"
FROM tb_pilotos
ORDER BY tb_pilotos.salario ASC;
